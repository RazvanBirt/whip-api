# ============================================================
# Whip API - Local development environment
# ============================================================
# New computer / fresh clone:
#   cp .env.example .env
# Then paste your PRIVATE Supabase service-role key into:
#   SUPABASE_SERVICE_ROLE_KEY=
# ============================================================

# ---------------------------
# App
# ---------------------------
NODE_ENV=local
PORT=3000
APP_URL=http://localhost:3000

# ---------------------------
# Database - PostgreSQL
# ---------------------------
POSTGRES_USER=whipuser
POSTGRES_PASSWORD=whipuser_password
POSTGRES_DB=whip_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://whipuser:whipuser_password@localhost:5432/whip_db?schema=public

# ---------------------------
# JWT / Auth
# ---------------------------
# Local-development access-token secret.
# Replace with a strong random secret outside local development.
JWT_ACCESS_SECRET=change_me_access_very_long_random

# IMPORTANT: keep the unit. Use "15m", not just "15".
JWT_ACCESS_TTL=15m

# Refresh tokens are opaque session tokens in the current API.
REFRESH_TTL_DAYS=30

# Password-reset token lifetime.
RESET_TTL_MINUTES=30

# ---------------------------
# Cookies
# ---------------------------
COOKIE_SECRET=change_me_cookie_secret_long_random
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# ---------------------------
# Supabase
# ---------------------------
SUPABASE_URL=https://szrmpjeykqejfjzxnqqr.supabase.co

# PRIVATE SECRET - never commit the real service-role key.
SUPABASE_SERVICE_ROLE_KEY=PASTE_YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

SUPABASE_BUCKET=whip_images

# ============================================================
# Optional: run PostgreSQL without docker compose
# ============================================================
# docker run -d \
#   --name whip-postgres \
#   -p 5432:5432 \
#   -e POSTGRES_USER=whipuser \
#   -e POSTGRES_PASSWORD=whipuser_password \
#   -e POSTGRES_DB=whip_db \
#   postgres:15
