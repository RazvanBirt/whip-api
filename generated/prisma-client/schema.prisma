generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma-client"
}

datasource db {
  provider = "postgresql"
}

// =========================
// CORE CATALOG (Clio-style)
// Make -> Model -> Generation -> Phase -> BodyVariant -> Version -> VersionConfig -> SpecSheet
// =========================

model Make {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  country   String?
  imageURL  String?
  imagePath String?

  models Model[]

  @@unique([name])
}

model Model {
  id     String @id @default(uuid()) @db.Uuid
  makeId String @db.Uuid
  name   String

  make Make @relation(fields: [makeId], references: [id], onDelete: Cascade)

  generations Generation[]

  @@unique([makeId, name])
  @@index([makeId])
}

model Generation {
  id        String @id @default(uuid()) @db.Uuid
  modelId   String @db.Uuid
  name      String // e.g. "Clio 3"
  startYear Int?
  endYear   Int? // null = present

  model Model @relation(fields: [modelId], references: [id], onDelete: Cascade)

  phases       Phase[]
  bodyVariants BodyVariant[]

  @@unique([modelId, name])
  @@index([modelId])
}

model Phase {
  id           String @id @default(uuid()) @db.Uuid
  generationId String @db.Uuid

  name      String // e.g. "Phase 1", "Phase 2" , "Facelift"
  startYear Int?
  endYear   Int?

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)

  versions Version[]

  @@unique([generationId, name])
  @@index([generationId])
}

model BodyType {
  id           String        @id @default(uuid()) @db.Uuid
  name         String        @unique // Hatchback, Estate, Sedan, SUV...
  bodyVariants BodyVariant[]
}

model BodyVariant {
  id           String @id @default(uuid()) @db.Uuid
  generationId String @db.Uuid
  bodyTypeId   String @db.Uuid

  // More specific than BodyType:
  // e.g. "3 Doors", "5 Doors", "Grand Tour", "Sport Tourer"
  name        String
  doors       Int?
  wheelbaseMm Int?
  notes       String?

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  bodyType   BodyType   @relation(fields: [bodyTypeId], references: [id], onDelete: Restrict)

  versions Version[]

  @@unique([generationId, bodyTypeId, name])
  @@index([generationId])
  @@index([bodyTypeId])
}

model Version {
  id            String  @id @default(uuid()) @db.Uuid
  bodyVariantId String  @db.Uuid
  phaseId       String? @db.Uuid

  // What the spec sites call a "version"
  // e.g. "1.2 16v Authentique eco2"
  name      String
  startYear Int?
  endYear   Int?

  bodyVariant BodyVariant @relation(fields: [bodyVariantId], references: [id], onDelete: Cascade)
  phase       Phase?      @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  configs VersionConfig[]

  @@unique([bodyVariantId, phaseId, name])
  @@index([bodyVariantId])
  @@index([phaseId])
}

model VersionConfig {
  id        String @id @default(uuid()) @db.Uuid
  versionId String @db.Uuid

  // Some sites have specs per year; keep optional.
  year Int?

  // Configuration links to your catalog tables
  engineId       String? @db.Uuid
  transmissionId String? @db.Uuid
  drivetrainId   String? @db.Uuid

  version Version @relation(fields: [versionId], references: [id], onDelete: Cascade)

  engine       Engine?       @relation(fields: [engineId], references: [id], onDelete: Restrict)
  transmission Transmission? @relation(fields: [transmissionId], references: [id], onDelete: Restrict)
  drivetrain   Drivetrain?   @relation(fields: [drivetrainId], references: [id], onDelete: Restrict)

  spec     SpecSheet?
  userCars UserCar[]

  // Ensures you don't create duplicates for same combo
  @@unique([versionId, year, engineId, transmissionId, drivetrainId])
  @@index([versionId])
  @@index([engineId])
  @@index([transmissionId])
  @@index([drivetrainId])
}

model SpecSheet {
  id              String @id @default(uuid()) @db.Uuid
  versionConfigId String @unique @db.Uuid

  // Common searchable fields
  fuelType           String?
  powerPsOverride    Int?
  powerKwOverride    Int?
  torqueNmOverride   Int?
  torqueLbftOverride Int?

  topSpeedKmh Int?
  zeroTo100   Float?

  lengthMm     Int?
  widthMm      Int?
  heightMm     Int?
  wheelbaseMm  Int?
  curbWeightKg Int?
  trunkLiters  Int?

  // Everything else (brakes, tires, aero, suspension, interior...) as flexible JSON
  data Json?

  versionConfig VersionConfig @relation(fields: [versionConfigId], references: [id], onDelete: Cascade)
}

// =========================
// POWERTRAIN CATALOG TABLES
// (keep your catalog-first approach)
// =========================

model Engine {
  id                 String  @id @default(uuid()) @db.Uuid
  code               String  @unique
  configuration      String?
  displacementLiters Float?
  displacementCc     Int?
  cylinders          Int?
  fuelType           String?
  aspiration         String?
  powerPs            Int?
  powerKw            Int?
  torqueNm           Int?
  torqueLbft         Int?

  // used by version configs and user cars
  versionConfigs VersionConfig[]
  userCars       UserCar[]

  @@index([code])
}

model Transmission {
  id    String  @id @default(uuid()) @db.Uuid
  type  String?
  gears Int?

  versionConfigs VersionConfig[]
  userCars       UserCar[]

  @@unique([type, gears])
}

model Drivetrain {
  id          String  @id @default(uuid()) @db.Uuid
  type        String?
  description String?

  versionConfigs VersionConfig[]
  userCars       UserCar[]

  @@unique([type, description])
}

// =========================
// USERS / AUTH (your original)
// =========================

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String
  displayName  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cars           UserCar[]
  settings       UserSetting[]
  sessions       Session[]
  passwordResets PasswordReset[]
}

model Session {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  refreshTokenHash String
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  expiresAt        DateTime

  @@index([userId])
}

model PasswordReset {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  expiresAt DateTime

  @@index([userId])
}

// =========================
// USER CAR
// Now points to VersionConfig (exact configuration)
// =========================

model UserCar {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // Chosen exact catalog config (version + engine/transmission/drivetrain + optional year)
  versionConfigId String @db.Uuid

  nickname     String?
  vin          String?
  licensePlate String?
  color        String?
  mileageKm    Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  versionConfig VersionConfig @relation(fields: [versionConfigId], references: [id], onDelete: Restrict)

  // Optional convenience links (denormalized access); keep if you want quick filtering:
  engineId       String? @db.Uuid
  transmissionId String? @db.Uuid
  drivetrainId   String? @db.Uuid

  engine       Engine?       @relation(fields: [engineId], references: [id], onDelete: Restrict)
  transmission Transmission? @relation(fields: [transmissionId], references: [id], onDelete: Restrict)
  drivetrain   Drivetrain?   @relation(fields: [drivetrainId], references: [id], onDelete: Restrict)

  @@index([userId])
  @@index([versionConfigId])
  @@index([engineId])
  @@index([transmissionId])
  @@index([drivetrainId])
}

model UserSetting {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  settingKey   String
  settingValue Json?
  updatedAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, settingKey])
}
